{
    admin localhost:2019
    email {$CADDY_EMAIL:admin@bucketapi.com}

    on_demand_tls {
        # FIX 1: Removed ?domain={host}
        # FIX 2: Changed localhost to bucketapi (standard docker networking)
        ask http://bucketapi:8000/api/caddy/check-domain
        interval 2m
        burst 5
    }

    log {
        output stdout
        format json
        level INFO
    }
}

:80 {
    redir https://{host}{uri} permanent
}

{$MAIN_DOMAIN:bucketapi.com} {
    # FIX: Changed localhost to bucketapi
    reverse_proxy bucketapi:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
    }

    handle /health {
        respond "OK" 200
    }

    log {
        output stdout
        format json
    }
}

https:// {
    tls {
        on_demand
    }

    # FIX: Changed localhost to bucketapi
    reverse_proxy bucketapi:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Custom-Domain {host}
    }

    log {
        output stdout
        format json
    }
}
