# Caddy Configuration for BucketAPI
# This file configures Caddy as a reverse proxy with automatic SSL/TLS

{
    # Enable Caddy admin API for dynamic configuration (localhost only for security)
    admin localhost:2019
    
    # Email for Let's Encrypt ACME account
    # IMPORTANT: Replace with your email or set CADDY_EMAIL environment variable
    email {$CADDY_EMAIL:admin@bucketapi.com}
    
    # On-demand TLS configuration
    # Caddy will ask the FastAPI app before issuing certificates
    on_demand_tls {
        ask http://localhost:8000/api/caddy/check-domain
        interval 2m
        burst 5
    }
    
    # Optional: Use staging Let's Encrypt for testing (uncomment for testing)
    # acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
    
    # Logging
    log {
        output stdout
        format json
        level INFO
    }
}

# HTTP to HTTPS redirect (catch-all for port 80)
:80 {
    redir https://{host}{uri} permanent
}

# Main domain configuration
# Replace {$MAIN_DOMAIN:bucketapi.com} with your actual domain
{$MAIN_DOMAIN:bucketapi.com} {
    reverse_proxy localhost:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
    
    # Enable automatic TLS for main domain
    tls {
        # Default TLS settings - Let's Encrypt will handle certificate
    }
    
    # Health check endpoint
    handle /health {
        respond "OK" 200
    }
    
    # Logging for main domain
    log {
        output stdout
        format json
    }
}

# Catch-all for custom domains with on-demand TLS
# This handles all custom domains dynamically
https:// {
    # On-demand TLS - certificates generated when accessed
    tls {
        on_demand
    }
    
    reverse_proxy localhost:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Custom-Domain {host}
    }
    
    # Logging for custom domains
    log {
        output stdout
        format json
    }
}



