{
    # Enable Caddy admin API
    admin localhost:2019
    
    # Email for Let's Encrypt
    email {$CADDY_EMAIL:admin@bucketapi.com}
    
    on_demand_tls {
        # ❌ OLD/BROKEN: ask http://localhost:8000/api/caddy/check-domain?domain={host}
        # ✅ CORRECTED: Remove the query parameter. Caddy adds '?domain=...' automatically.
        ask http://localhost:8000/api/caddy/check-domain
        
        interval 2m
        burst 5
    }
    
    # Logging
    log {
        output stdout
        format json
        level INFO
    }
}

# HTTP to HTTPS redirect
:80 {
    redir https://{host}{uri} permanent
}

# Main domain configuration
{$MAIN_DOMAIN:bucketapi.com} {
    reverse_proxy localhost:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-For {remote_host}
    }
    
    handle /health {
        respond "OK" 200
    }
    
    log {
        output stdout
        format json
    }
}

# Catch-all for custom domains
https:// {
    tls {
        on_demand
    }
    
    reverse_proxy localhost:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-For {remote_host}
        header_up X-Custom-Domain {host}
    }
    
    log {
        output stdout
        format json
    }
}
